          "c221cf1c-b707-4b7a-1905-37f139215bfc": {
            "id": "c221cf1c-b707-4b7a-1905-37f139215bfc",
            "type": "image",
            "name": "Image",
            "parentId": "page",
            "childIndex": 10,
            "point": [
              2159.33,
              2295.54
            ],
            "size": [
              306,
              396
            ],
            "rotation": 0,
            "style": {
              "color": "lightGray",
              "size": "small",
              "isFilled": false,
              "dash": "draw",
              "scale": 1,
              "font": "serif"
            },
            "assetId": "c221cf1c-b707-4b7a-1905-37f139215bfc",
            "paper": {
              "doi": "10.1145/3428290",
              "s2id": "12243d14abcafac95103ff4d2ea5e030f2ee8eb3",
              "semanticScholarData": {
                "paperId": "12243d14abcafac95103ff4d2ea5e030f2ee8eb3",
                "externalIds": {
                  "ArXiv": "2010.12695",
                  "MAG": "3109289644",
                  "DBLP": "journals/corr/abs-2010-12695",
                  "DOI": "10.1145/3428290",
                  "CorpusId": 225067888
                },
                "title": "Adding interactive visual syntax to textual code",
                "abstract": "Many programming problems call for turning geometrical thoughts into code: tables, hierarchical structures, nests of objects, trees, forests, graphs, and so on. Linear text does not do justice to such thoughts. But, it has been the dominant programming medium for the past and will remain so for the foreseeable future. This paper proposes a novel mechanism for conveniently extending textual programming languages with problem-specific visual syntax. It argues the necessity of this language feature, demonstrates the feasibility with a robust prototype, and sketches a design plan for adapting the idea to other languages.",
                "venue": "Proc. ACM Program. Lang.",
                "year": 2020,
                "openAccessPdf": {
                  "url": "https://dl.acm.org/doi/pdf/10.1145/3428290",
                  "status": "GOLD"
                },
                "tldr": {
                  "model": "tldr@v2.0.0",
                  "text": "This paper proposes a novel mechanism for conveniently extending textual programming languages with problem-specific visual syntax, and argues the necessity of this language feature, demonstrates the feasibility with a robust prototype, and sketches a design plan for adapting the idea to other languages."
                },
                "authors": [
